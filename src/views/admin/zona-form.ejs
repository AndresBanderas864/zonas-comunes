<%
  const DIAS = ['Lunes', 'Martes', 'Miercoles', 'Jueves', 'Viernes', 'Sabado', 'Domingo'];
  const accion = zona ? `/admin/zonas/${zona.id}` : '/admin/zonas/nueva';
  const porDia = new Map();
  if (zona) {
    for (const h of zona.horarios) porDia.set(h.diaSemana, h);
  }
  const activa = zona ? zona.activa : true;
%>
<section>
  <h1><%= zona ? `Editar zona: ${zona.nombre}` : 'Nueva zona' %></h1>
  <% if (error) { %>
  <p class="mensaje mensaje-error" role="alert"><%= error %></p>
  <% } %>
  <form method="post" action="<%= accion %>">
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <% } %>
    <p>
      <label for="nombre">Nombre</label><br />
      <input id="nombre" name="nombre" type="text" required maxlength="80"
        value="<%= zona ? zona.nombre : '' %>" />
    </p>
    <p>
      <label for="aforo">Aforo (personas)</label><br />
      <input id="aforo" name="aforo" type="number" min="1" step="1" required
        value="<%= zona ? zona.aforo : '' %>" />
    </p>
    <p>
      <label for="duracionBloqueMin">Duracion del bloque (minutos)</label><br />
      <input id="duracionBloqueMin" name="duracionBloqueMin" type="number" min="1" step="1" required
        value="<%= zona ? zona.duracionBloqueMin : '' %>" />
    </p>
    <p>
      <label for="maxCuposReserva">Cupos maximos por reserva</label><br />
      <input id="maxCuposReserva" name="maxCuposReserva" type="number" min="1" step="1" required
        value="<%= zona ? zona.maxCuposReserva : '' %>" />
    </p>
    <p>
      <input id="activa" name="activa" type="checkbox" value="1" <%= activa ? 'checked' : '' %> />
      <label for="activa">Zona activa</label>
    </p>
    <fieldset>
      <legend>Horarios por dia de la semana</legend>
      <% for (let dia = 1; dia <= 7; dia++) { %>
      <% const h = porDia.get(dia); %>
      <p>
        <input type="hidden" name="horarios[<%= dia - 1 %>][diaSemana]" value="<%= dia %>" />
        <label>
          <%= DIAS[dia - 1] %>
          <input name="horarios[<%= dia - 1 %>][apertura]" type="time" value="<%= h ? h.apertura : '' %>" />
          <input name="horarios[<%= dia - 1 %>][cierre]" type="time" value="<%= h ? h.cierre : '' %>" />
        </label>
      </p>
      <% } %>
    </fieldset>
    <p><button type="submit">Guardar zona</button></p>
  </form>
  <p><a href="/admin/zonas">Volver al listado</a></p>
</section>
