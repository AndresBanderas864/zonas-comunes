<section>
  <h1>Zonas comunes</h1>
  <p>
    <a class="boton" href="/admin/zonas/nueva">Nueva zona</a>
  </p>
  <% if (!zonas || zonas.length === 0) { %>
  <p>Aun no hay zonas configuradas.</p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th scope="col">Nombre</th>
        <th scope="col">Aforo</th>
        <th scope="col">Duracion del bloque (min)</th>
        <th scope="col">Cupos maximos por reserva</th>
        <th scope="col">Estado</th>
        <th scope="col">Horarios</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% const DIAS = ['Lunes', 'Martes', 'Miercoles', 'Jueves', 'Viernes', 'Sabado', 'Domingo']; %>
      <% for (const zona of zonas) { %>
      <tr>
        <th scope="row"><%= zona.nombre %></th>
        <td><%= zona.aforo %></td>
        <td><%= zona.duracionBloqueMin %></td>
        <td><%= zona.maxCuposReserva %></td>
        <td><%= zona.activa ? 'Activa' : 'Inactiva' %></td>
        <td>
          <% if (zona.horarios.length === 0) { %>
          Sin horarios
          <% } else { %>
          <ul>
            <% for (const h of zona.horarios) { %>
            <li><%= DIAS[h.diaSemana - 1] %>: <%= h.apertura %> - <%= h.cierre %></li>
            <% } %>
          </ul>
          <% } %>
        </td>
        <td>
          <a href="/admin/zonas/<%= zona.id %>">Editar</a>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>
</section>
