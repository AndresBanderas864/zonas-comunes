<section>
  <h1>Notificaciones</h1>

  <% if (!notificaciones || notificaciones.length === 0) { %>
  <p>No tienes notificaciones.</p>
  <% } else { %>
  <% const TIPOS = { CONFIRMACION: 'Confirmación', CANCELACION: 'Cancelación', RECORDATORIO: 'Recordatorio' }; %>
  <ul class="notificaciones">
    <% for (const notificacion of notificaciones) { %>
    <li class="<%= notificacion.leida ? 'leida' : 'sin-leer' %>">
      <h2><%= notificacion.titulo %></h2>
      <p><%= notificacion.mensaje %></p>
      <p class="detalle">
        <%= TIPOS[notificacion.tipo] || notificacion.tipo %> ·
        <%= notificacion.creadaEn %>
        <% if (notificacion.leida) { %>
        · Leída
        <% } %>
      </p>
      <% if (!notificacion.leida) { %>
      <form method="post" action="/notificaciones/<%= notificacion.id %>/leida">
        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <% } %>
        <button type="submit">Marcar como leída</button>
      </form>
      <% } %>
    </li>
    <% } %>
  </ul>
  <% } %>
</section>
