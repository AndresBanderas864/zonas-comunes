<section>
  <h1>Mis reservas</h1>

  <h2>Próximas</h2>
  <% if (!proximas || proximas.length === 0) { %>
  <p>No tienes reservas próximas.</p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th scope="col">Zona</th>
        <th scope="col">Fecha</th>
        <th scope="col">Bloque</th>
        <th scope="col">Cupos</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% for (const reserva of proximas) { %>
      <tr>
        <th scope="row"><%= reserva.zonaNombre %></th>
        <td><%= reserva.fecha %></td>
        <td><%= reserva.horaInicio %> – <%= reserva.horaFin %></td>
        <td><%= reserva.cupos %></td>
        <td>
          <form method="post" action="/reservas/<%= reserva.id %>/cancelar">
            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <% } %>
            <label for="motivo-<%= reserva.id %>">Motivo</label>
            <input id="motivo-<%= reserva.id %>" name="motivo" type="text" maxlength="255"
              placeholder="Motivo (opcional)" />
            <button type="submit">Cancelar reserva</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>

  <h2>Historial</h2>
  <% if (!pasadas || pasadas.length === 0) { %>
  <p>Aun no tienes reservas en el historial.</p>
  <% } else { %>
  <table>
    <thead>
      <tr>
        <th scope="col">Zona</th>
        <th scope="col">Fecha</th>
        <th scope="col">Bloque</th>
        <th scope="col">Cupos</th>
        <th scope="col">Estado</th>
      </tr>
    </thead>
    <tbody>
      <% const ESTADOS = { CONFIRMADA: 'Confirmada', CANCELADA: 'Cancelada', VENCIDA: 'Vencida' }; %>
      <% for (const reserva of pasadas) { %>
      <tr>
        <th scope="row"><%= reserva.zonaNombre %></th>
        <td><%= reserva.fecha %></td>
        <td><%= reserva.horaInicio %> – <%= reserva.horaFin %></td>
        <td><%= reserva.cupos %></td>
        <td><%= ESTADOS[reserva.estado] || reserva.estado %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>
</section>
